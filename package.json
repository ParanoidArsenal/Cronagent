{
  "name": "cronagent",
  "version": "0.1.0",
  "description": "Schedule and orchestrate autonomous Claude Code agents — cron triggers, web dashboard, run history, budget controls",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "cronagent": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "repl": "tsx src/index.ts repl",
    "daemon": "tsx src/index.ts daemon",
    "web": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:ci": "vitest run",
    "test:e2e": "cd web && npm run test:e2e"
  },
  "dependencies": {
    "commander": "^12.0.0",
    "croner": "^9.0.0",
    "execa": "^9.0.0",
    "gray-matter": "^4.0.3",
    "js-yaml": "^4.1.0",
    "pg": "^8.20.0",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "readline": "^1.3.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.2"
  }
}
