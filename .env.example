# ── Database ──────────────────────────────────────────────
# PostgreSQL connection string (required)
DATABASE_URL=postgresql://automation:automation@db:5432/automation_repl

# ── Application ──────────────────────────────────────────
# Directory containing automation .md/.yaml files
AUTOMATIONS_DIR=/app/automations

# Path to MCP server configuration file
MCP_CONFIG=/app/mcp.json

# Docker image used for sandboxed automation execution
SANDBOX_IMAGE=automation-repl-sandbox

# Pino log level: trace, debug, info, warn, error, fatal
LOG_LEVEL=info

# ── Notifications ────────────────────────────────────────
# Slack/Mattermost incoming webhook URL for run notifications.
# When set, a POST is sent after every automation run (unless notify: false in frontmatter).
# WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Telegram Bot API notifications.
# Create a bot via @BotFather, get the token, and find your chat_id.
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# TELEGRAM_CHAT_ID=-1001234567890

# Mattermost incoming webhook URL (separate from MCP integration).
# MATTERMOST_WEBHOOK_URL=https://mattermost.example.com/hooks/xxx-yyy-zzz

# ── Webhook Triggers ─────────────────────────────────────
# Secret token for GitLab webhook validation (X-Gitlab-Token header).
# Set this in your GitLab webhook configuration under "Secret token".
# If unset, the webhook endpoint accepts all requests (not recommended for production).
# GITLAB_WEBHOOK_SECRET=your-secret-token-here

# ── Web Server ───────────────────────────────────────────
# Port for the Next.js web server
PORT=3000

# Hostname binding (0.0.0.0 to accept external connections)
HOSTNAME=0.0.0.0

# ── MCP Server Credentials (optional) ───────────────────
# These are interpolated into mcp.json via ${VAR} syntax.
# Only needed if you use the corresponding MCP integrations.
# For detailed setup, see .env.mcp.example

# JIRA_URL=https://jira.just-ai.com
# JIRA_TOKEN=
# JIRA_JSESSIONID=  # Optional: for downloading attachments (Browser DevTools → Cookies)

# GITLAB_URL=https://gitlab.just-ai.com
# GITLAB_TOKEN=

# MATTERMOST_URL=
# MATTERMOST_TOKEN=

# CAILA_BASE_URL=https://caila.io
# CAILA_API_KEY=
