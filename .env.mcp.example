# MCP Servers Configuration
# Copy to .env.mcp and fill in your values:
#   cp .env.mcp.example .env.mcp

# === Jira ===
# Jira Server URL
JIRA_URL=https://jira.just-ai.com
# Personal Access Token (Profile → Personal Access Tokens → Create)
JIRA_TOKEN=
# Optional: JSESSIONID for downloading attachments
# Browser DevTools → Application → Cookies → jira.just-ai.com → JSESSIONID
JIRA_JSESSIONID=

# === GitLab ===
# GitLab Server URL
GITLAB_URL=https://gitlab.just-ai.com
# Personal Access Token (Preferences → Access Tokens → Create with api scope)
GITLAB_TOKEN=

# === Mattermost ===
MATTERMOST_URL=
MATTERMOST_TOKEN=
